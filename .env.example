# OmniAI public edition environment template
#
# The Flask server reads process environment variables. It does not load .env
# by itself; either export these values in the shell or run through a dotenv
# launcher, for example: python -m dotenv run -- python run.py
#
# Never commit a populated .env file or provider credentials.

# Inbound authentication for the local proxy. Use a long, random value.
PROXY_AUTH_KEY=replace-with-a-long-random-value

# Configure only the provider credentials you intend to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Used by omniaicli.py; run.py defaults to 127.0.0.1:8000.
OMNIAI_PROXY_URL=http://127.0.0.1:8000

# run.py bind/debug controls. Keep the local-only defaults unless deploying
# behind an authenticated reverse proxy and TLS.
OMNIAI_HOST=127.0.0.1
OMNIAI_PORT=8000
OMNIAI_DEBUG=0

# Optional exact OpenRouter upstream IDs (comma/newline/JSON-list syntax).
# Current examples include moonshotai/kimi-k3, openai/gpt-5.5,
# openai/gpt-5.6-sol, and anthropic/claude-opus-5.
OPENROUTER_MODELS=moonshotai/kimi-k3

# Safer local defaults for diagnostics and optional response metadata.
OMNI_DEBUG_PAYLOADS=0
OMNI_DEBUG_STREAM_CHUNKS=0
STREAM_DEBUG_SAMPLE_N=10
OMNI_DETAILED_STREAM_LOGGING=0
OMNI_STREAM_LOGGING_LEVEL=0
OPENAI_INCLUDE_USAGE=0
ALLOW_INCLUDE_THOUGHTS=0

# Upstream request timeouts, in seconds.
HTTP_CONNECT_TIMEOUT=10
HTTP_READ_TIMEOUT=600
